{
  "name": "cypress-techcorp-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "delete:reports": "rm -r cypress/results/* || true",
    "prereport": "npm run delete:reports",
    "mochawesome:merge": "npx mochawesome-merge \"cypress/results/mochawesome/*.json\" > mochawesome.json && npx marge mochawesome.json",
    "junit:merge": "npx junit-merge -d cypress/results/junit -o cypress/results/junit/result.xml",
    "run_stg_api": "CYPRESS_BASE_URL=https://techcorp-web.dev.example.com npx cypress run --env API_URL=https://techcorp-backend.dev.example.com/,B2C_URL=https://devs.b2clogin.com/ --spec './cypress/e2e/WEB/TECHSPACE/API/*.spec.js'",
    "run_stg_ui": "CYPRESS_BASE_URL=https://techcorp-web.dev.example.com npx cypress run --env API_URL=https://techcorp-backend.dev.example.com/,B2C_URL=https://devs.b2clogin.com/ --spec './cypress/e2e/WEB/TECHSPACE/UI/*.spec.js'",
    "cypress:open_stg": "CYPRESS_BASE_URL=https://techcorp-web.dev.example.com npx cypress open --env API_URL=https://techcorp-backend.dev.example.com/,B2C_URL=https://devs.b2clogin.com/",
    "cypress:run_stg": "npm run prereport && npm run run_stg; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_stg_api": "npm run prereport && npm run run_stg_api ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_stg_ui": "npm run prereport && npm run run_stg_ui ; npm run junit:merge; npm run mochawesome:merge",
    "run_techspace_dev_api": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHSPACE/API/**/*.spec.js'",
    "run_techspace_dev_ui_id": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHSPACE/UI/ID/*.spec.js'",
    "run_techspace_dev_ui_en": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHSPACE/UI/EN/*.spec.js'",
    "run_techcorp_dev_api": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHCORP/API/**/*.spec.js'",
    "run_techcorp_dev_ui_id": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHCORP/UI/ID/*.spec.js'",
    "run_techcorp_dev_ui_en": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress run --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/ --spec './cypress/e2e/WEB/TECHCORP/UI/EN/*.spec.js'",
    "cypress:run_techspace_api_qa": "npm run prereport && npm run run_techspace_dev_api ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_techspace_ui-id_qa": "npm run prereport && npm run run_techspace_dev_ui_id ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_techspace_ui-en_qa": "npm run prereport && npm run run_techspace_dev_ui_en ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_techcorp_api_qa": "npm run prereport && npm run run_techcorp_dev_api ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_techcorp_ui-id_qa": "npm run prereport && npm run run_techcorp_dev_ui_id ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:run_techcorp_ui-en_qa": "npm run prereport && npm run run_techcorp_dev_ui_en ; npm run junit:merge; npm run mochawesome:merge",
    "cypress:open_techcorp_qa": "CYPRESS_BASE_URL=https://qa.techcorp.com npx cypress open --env API_URL=https://qa-techspaceapi.techcorp.com/,B2C_URL=https://techcorpb2cdev.b2clogin.com/"
  },
  "keywords": [],
