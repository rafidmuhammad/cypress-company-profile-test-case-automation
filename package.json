  "license": "ISC",
  "dependencies": {
    "chai-json-schema": "^1.5.1",
    "cypress": "^13.6.3",
    "faker": "^5.5.3",
    "imap-simple": "^1.6.3",
    "mailparser": "^3.6.7",
    "nodemailer": "^6.9.9"
  },
  "devDependencies": {
    "cypress-multi-reporters": "^1.6.4",
    "cypress-recurse": "^1.35.3",
    "junit-merge": "^2.0.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
