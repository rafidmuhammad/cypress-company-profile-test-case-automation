      {
        "id": 1,
        "attributes": {
          "name_id": "Digital Ventures",
          "name_en": "Digital Ventures",
          "description_id": "Kami mengeksplorasi dan menggabungkan kefasihan teknologi dengan keahlian industri untuk menciptakan solusi yang menguasai pasar yang kompetitif.",
          "description_en": "We thrive by exploring and combining technology fluency with industry expertise to create solutions that master competitive markets.",
          "heroYoutubeLink": "https://www.youtube.com/watch?v=nTp2-pmjjkA",
          "slug": "digital-ventures",
          "techcorpPortfolio": [
            {
              "position": 1,
              "updatedAt": "2024-04-29T09:25:17.215Z",
              "id": 13,
              "title": "Mapan",
              "slug": "mapan",
              "websiteUrl": "https://www.career.mapan.id",
              "short_description_id": "deskripsi data intel 3",
              "short_description_en": "data intel 3 description",
              "about_id": "Mapan adalah suatu platform perdagangan sosial berbasis komunitas digital. Mapan memiliki misi untuk meningkatkan akses, derajat, dan pendapatan masyarakat Indonesia.\n\nTechCorp memimpin penggalangan dana Seri A untuk Mapan pada tahun 2022.",
              "about_en": "Mapan is a digital community-based social commerce platform. Mapan has a mission to increase the access, status, and income of the Indonesian people.\n\nTechCorp served as the lead investor for Mapan Series A fundraising in 2022.",
              "year": 2024,
              "ifHasDetail": true,
