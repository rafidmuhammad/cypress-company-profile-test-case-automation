      {
        "id": 2,
        "attributes": {
          "name_id": "Venture Building",
          "name_en": "Venture Building",
          "description_id": "Pengembangan usaha rintisan telah menjadi strategi penting bagi perusahaan, tidak hanya untuk mempertahankan pertumbuhan jangka panjang tetapi juga untuk tetap relevan dengan pelanggan dan pemangku kepentingan lainnya. Dalam beberapa tahun terakhir, TechCorp telah menginkubasi dan meluncurkan beberapa usaha dan produk digital baru sebagai respons terhadap perubahan perkembangan teknologi dan permintaan serta preferensi pelanggan.",
          "description_en": "Pengembangan usaha rintisan telah menjadi strategi penting bagi perusahaan, tidak hanya untuk mempertahankan pertumbuhan jangka panjang tetapi juga untuk tetap relevan dengan pelanggan dan pemangku kepentingan lainnya. Dalam beberapa tahun terakhir, TechCorp telah menginkubasi dan meluncurkan beberapa usaha dan produk digital baru sebagai respons terhadap perubahan perkembangan teknologi dan permintaan serta preferensi pelanggan.",
          "heroYoutubeLink": "gaCR3WX-J60",
          "slug": "venture-building",
          "techcorpPortfolio": [
            {
              "position": 1,
              "updatedAt": "2024-04-19T10:47:42.977Z",
              "id": 17,
              "title": "AutoDealer",
              "slug": "autodealer",
              "websiteUrl": "https://www.autodealer.techcorp.com",
              "short_description_id": "deskripsi data intel 4",
              "short_description_en": "data intel 4 description",
              "about_id": "Memberikan solusi pembangunan usaha untuk membantu upaya pembangunan usaha AutoDealer.\n\n1. Melakukan riset pasar untuk mendapatkan ukuran pasar & tren pertumbuhan.\n\n2. Melakukan pembandingan pesaing untuk memahami lanskap persaingan & menemukan peluang masuk.\n\n3. Mengembangkan model bisnis potensial & penggerak pendapatan.\n\n4. Melakukan review & rekomendasi produk.",
              "about_en": "Delivered venture building solutions to assist in AutoDealer venture building efforts.\n\n1. Conducted market research to obtain market sizing & growth trends.\n\n2. Performed competitor benchmarking to understand competitive landscape & discover entry opportunities.\n\n3. Developed potential business models & revenue drivers.\n\n4. Performed product review & recommendation.",
              "year": 2024,
              "ifHasDetail": true,
