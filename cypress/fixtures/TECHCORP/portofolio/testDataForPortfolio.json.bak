  "portoDetail": {
    "data": {
      "id": 2,
      "title": "TechCorp Digital C-Level Masterclass",
      "slug": "techcorp-digital-c-level-masterclass",
      "websiteUrl": "https://www.seva.id/",
      "short_description_id": "satu",
      "short_description_en": "one",
      "about_id": "TechCorp Digital Masterclass adalah seminar triwulanan untuk para pemimpin senior di Grup TechCorp yang mengundang pembicara dari perusahaan terkemuka untuk berbagi keahlian dan pengalaman tentang topik digital & inovasi strategis.\n\nSejak tahun 2021, TechCorp Digital Masterclass telah dilaksanakan sebanyak lima kali dengan topik Digital Venture Building, Digital Talent Strategy, Data-Driven Business Strategy, Artificial Intelligence for Business Growth, CRM 101 Tren & Strategi untuk Mendorong Pertumbuhan Pelanggan.",
      "about_en": "TechCorp Digital Masterclass is a quarterly seminar for senior leaders at TechCorp Group, where we invite speakers from leading corporations to share expertise and experiences on strategic digital & innovation topics. \n\nSince 2021, TechCorp Digital Masterclass has been conducted five times with the topic of Digital Venture Building, Digital Talent Strategy, Data-Driven Business Strategy, Artificial Intelligence for Business Growth, CRM 101 Trends & Strategy to Drive Customer Growth.",
      "year": 2024,
      "techcorpService": {
        "name_id": "Academy & Technology",
        "name_en": "Academy & Technology",
        "description_id": "Untuk mengimbangi kebutuhan akan talenta digital yang terus meningkat, TechCorp merasa perlu untuk membekali tenaga kerjanya dengan kemampuan digital yang sangat dibutuhkan untuk mempertahankan relevansinya dengan pelanggan dan karyawan.",
        "description_en": "To keep up with the growing need for digital talent, TechCorp finds a need to equip its workforce with the much-needed digital capabilities to maintain its relevancy towards both its customers and employees.",
        "heroYoutubeLink": "https://www.youtube.com/watch?v=nTp2-pmjjkA",
        "slug": "academy-and-technology"
      },
