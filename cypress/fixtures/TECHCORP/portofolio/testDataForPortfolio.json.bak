            {
              "position": 2,
              "updatedAt": "2024-04-29T09:23:40.225Z",
              "id": 10,
              "title": "TechCorp AutoShop",
              "slug": "techcorp-autoshop",
              "websiteUrl": "https://www.techcorpautoshop.com/",
              "short_description_id": null,
              "short_description_en": null,
              "about_id": "TechCorp AutoShop berada di bawah naungan PT Ardendi Jaya Sentosa, salah satu anak perusahaan PT TechCorp AutoParts yang bergerak di bidang manufaktur dan distribusi suku cadang kendaraan roda dua dan roda empat di Indonesia untuk pasar pembuatan dan penggantian otomotif pasar suku cadang.\n\nTechCorp Digital membantu TechCorp AutoShop dalam hal pengembangan brand campaign, produksi aset digital kreatif, dan strategi & implementasi pemasaran berbayar.",
              "about_en": "TechCorp AutoShop is under the auspices of PT Ardendi Jaya Sentosa, a subsidiary of PT TechCorp AutoParts which is engaged in the manufacturing and distribution of spare parts for two-wheeled and four-wheeled vehicles in Indonesia for the automotive manufacturing market and replacement parts market.\n\nTechCorp Digital assists TechCorp AutoShop in terms of brand campaign development, creative digital assets production, and paid marketing strategy & implementation.",
              "year": 2024,
              "ifHasDetail": true,
              "logo": {
