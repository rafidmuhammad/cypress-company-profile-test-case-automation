      {
        "id": 3,
        "attributes": {
          "name_id": "Strategy & Consulting",
          "name_en": "Strategy & Consulting",
          "description_id": "Dengan meningkatnya digitalisasi di semua aspek kehidupan, penting bagi perusahaan untuk mengintegrasikan teknologi ke dalam model bisnis yang sudah ada agar dapat melayani pelanggan dengan lebih baik dan meningkatkan efisiensi organisasi secara keseluruhan.",
          "description_en": "With the increasing digitalization of all aspects in life, it has become essential for companies to integrate technologies into their existing business model to better serve customers and increase overall organizational efficiency.",
          "heroYoutubeLink": "https://www.youtube.com/watch?v=nTp2-pmjjkA",
          "slug": "strategy-and-consulting",
          "techcorpPortfolio": [
            {
              "position": 1,
              "updatedAt": "2024-04-19T10:46:33.024Z",
              "id": 15,
              "title": "AutoRetail Customer Journey Workshop",
              "slug": "autoretail-customer-journey-workshop",
              "websiteUrl": "https://autoretail.co.id/",
              "short_description_id": "deskripsi data intel 5",
              "short_description_en": "data intel 5 description",
              "about_id": "AutoRetail along with TechCorp Digital strive to identify potential digital initiatives to strengthen AutoRetail Omnichannel strategy by considering internal, external pain points and trend in the industry. The result of the workshops are 3 prioritized ideas that is agreed by the management to be executed by AutoRetail. \n\nThe result of the workshops are 3 prioritized ideas that is agreed by the management to be executed by TechCorp Motor. To answer the objectives, TechCorp Digital has conducted 3 main activities. Start from Pre-Workshop, Workshop, and Synthesis Project.",
              "about_en": "AutoRetail along with TechCorp Digital strive to identify potential digital initiatives to strengthen AutoRetail Omnichannel strategy by considering internal, external pain points and trend in the industry. The result of the workshops are 3 prioritized ideas that is agreed by the management to be executed by AutoRetail. \n\nThe result of the workshops are 3 prioritized ideas that is agreed by the management to be executed by TechCorp Motor. To answer the objectives, TechCorp Digital has conducted 3 main activities. Start from Pre-Workshop, Workshop, and Synthesis Project.",
              "year": 2024,
