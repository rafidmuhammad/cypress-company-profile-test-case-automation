  "portoDetail2": {
    "data": {
      "id": 1,
      "title": "DigiTalk",
      "slug": "digi-talk",
      "websiteUrl": "https://www.youtube.com/channel/UCDAb9iYfc6qTGpJp3eiwzxg",
      "short_description_id": null,
      "short_description_en": null,
      "about_id": "Sesi diskusi bulanan yang mengundang pembicara eksternal dan pakar materi pelajaran untuk berbagi pengetahuan dan wawasan tentang segala hal yang bersifat digital. Mulai dari tren digital, bisnis digital, pemasaran digital, pengembangan produk, hingga analitik data, dengan harapan dapat menambah perspektif baru dan menciptakan inspirasi bagi karyawan Grup TechCorp dan masyarakat umum.",
      "about_en": "A monthly event inviting external speakers and subject matter experts to share knowledge and insights about everything digital. Start from digital trends, digital business, digital marketing, product development, to data analytics, in the hopes of adding new perspectives and creating inspiration to TechCorp Group employees and the general public.",
      "year": 2024,
      "ifHasDetail": true,
      "techcorpService": {
        "name_id": "Academy & Technology",
        "name_en": "Academy & Technology",
        "description_id": "Untuk mengimbangi kebutuhan akan talenta digital yang terus meningkat, TechCorp merasa perlu untuk membekali tenaga kerjanya dengan kemampuan digital yang sangat dibutuhkan untuk mempertahankan relevansinya dengan pelanggan dan karyawan.",
        "description_en": "To keep up with the growing need for digital talent, TechCorp finds a need to equip its workforce with the much-needed digital capabilities to maintain its relevancy towards both its customers and employees.",
        "heroYoutubeLink": "https://www.youtube.com/watch?v=nTp2-pmjjkA",
        "slug": "academy-and-technology"
      },
